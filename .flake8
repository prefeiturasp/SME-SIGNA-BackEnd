[flake8]
max-line-length = 79
extend-exclude =
    migrations,
    venv,
    node_modules,
    staticfiles,
    htmlcov,
    __pycache__,
    .git,
    .pytest_cache,
    .mypy_cache,
    .ruff_cache
# Conflitos comuns com black:
# E203: whitespace before ':' (black usa)
# W503: line break before binary operator (PEP 8 atualizada permite)
extend-ignore = E203, W503
per-file-ignores =
    __init__.py: F401
    settings/*.py: E501
    */migrations/*: ALL